if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT OR NOT DEFINED SYMBOL)
    message(FATAL_ERROR "EmbedSpirv requires INPUT, OUTPUT and SYMBOL")
endif()
file(READ "${INPUT}" spirv HEX)
string(LENGTH "${spirv}" length)
math(EXPR remainder "${length} % 8")
if(length LESS 40 OR NOT remainder EQUAL 0)
    message(FATAL_ERROR "Invalid SPIR-V word count: ${INPUT}")
endif()
string(SUBSTRING "${spirv}" 0 8 magic)
if(NOT magic STREQUAL "03022307")
    message(FATAL_ERROR "Invalid little-endian SPIR-V input: ${INPUT}")
endif()
set(header "#pragma once\n#include <cstdint>\nnamespace simforge::renderer::detail::shaders {\ninline constexpr std::uint32_t ${SYMBOL}[] = {\n")
math(EXPR last "${length} - 8")
foreach(offset RANGE 0 ${last} 8)
    foreach(byte RANGE 0 3)
        math(EXPR index "${offset} + ${byte} * 2")
        string(SUBSTRING "${spirv}" ${index} 2 b${byte})
    endforeach()
    string(APPEND header "0x${b3}${b2}${b1}${b0}u,\n")
endforeach()
string(APPEND header "};\n}\n")
file(WRITE "${OUTPUT}" "${header}")
