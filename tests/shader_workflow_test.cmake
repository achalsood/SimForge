set(directory "${BINARY_DIR}/shader-workflow")
file(MAKE_DIRECTORY "${directory}")
foreach(index RANGE 1 2)
    execute_process(COMMAND "${COMPILER}" --target-env=vulkan1.1 -O "${SOURCE_DIR}/engine/shaders/scene.vert"
        -o "${directory}/${index}.spv" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Shader compilation failed: ${output}${error}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DINPUT=${directory}/${index}.spv" "-DOUTPUT=${directory}/${index}.hpp"
        -DSYMBOL=test_shader -P "${SOURCE_DIR}/cmake/EmbedSpirv.cmake" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Embedding shader failed")
    endif()
endforeach()
foreach(extension spv hpp)
    file(SHA256 "${directory}/1.${extension}" first)
    file(SHA256 "${directory}/2.${extension}" second)
    if(NOT first STREQUAL second)
        message(FATAL_ERROR "Identical shader inputs produced different ${extension} outputs")
    endif()
endforeach()
file(READ "${directory}/1.hpp" header)
string(FIND "${header}" "0x07230203u" magic)
if(magic LESS 0)
    message(FATAL_ERROR "SPIR-V word encoding is incorrect")
endif()
file(WRITE "${directory}/invalid.vert" "#version 450\nvoid main() { broken; }\n")
execute_process(COMMAND "${COMPILER}" "${directory}/invalid.vert" -o "${directory}/invalid.spv"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "error")
    message(FATAL_ERROR "Invalid shader must fail with an actionable diagnostic")
endif()
file(WRITE "${directory}/invalid.spv" "bad!")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DINPUT=${directory}/invalid.spv" "-DOUTPUT=${directory}/invalid.hpp"
    -DSYMBOL=bad -P "${SOURCE_DIR}/cmake/EmbedSpirv.cmake" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0)
    message(FATAL_ERROR "Invalid SPIR-V was accepted")
endif()
